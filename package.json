{
  "name": "next-product-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "build": "next build",
    "format": "prettier . --write",
    "preinstall": "only-allow pnpm",
    "test": "jest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "generate-large-data": "node ./scripts/generateLargeData.js",
    "generate-small-data": "node ./scripts/generateSmallData.js",
    "seed-database": "tsx scripts/seedDatabase.ts",
    "docker-config": "docker compose --env-file .env.local -p product -f infra/docker-compose.dev.yaml config",
    "docker-up": "docker compose --env-file .env.local -p product -f infra/docker-compose.dev.yaml up",
    "docker-build": "docker compose --env-file .env.local -p product -f infra/docker-compose.dev.yaml build",
    "docker-build-up": "pnpm run docker-build && pnpm run docker-up",
    "docker-down": "docker compose --env-file .env.local -p product -f infra/docker-compose.dev.yaml down",
    "drizzle-studio": "npx drizzle-kit studio",
    "drizzle-migrate": "npx drizzle-kit migrate",
    "drizzle-pull": "npx drizzle-kit pull",
    "drizzle-generate": "npx drizzle-kit generate"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.816.0",
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.13",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-toast": "^1.2.14",
    "@tanstack/react-query": "^5.77.2",
    "@trpc/client": "^11.1.2",
    "@trpc/react-query": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "fs": "0.0.1-security",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.511.0",
    "next": "14.1.0",
    "postgres": "^3.4.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.56.4",
    "rxjs": "^7.8.2",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.0",
    "vaul": "^1.1.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^8.4.1",
    "@storybook/addon-essentials": "^7.6.15",
    "@storybook/addon-interactions": "^7.6.15",
    "@storybook/addon-links": "^7.6.15",
    "@storybook/addon-onboarding": "^1.0.11",
    "@storybook/blocks": "^7.6.15",
    "@storybook/nextjs": "^7.6.15",
    "@storybook/react": "^7.6.15",
    "@storybook/test": "^7.6.15",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.15.2",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.17",
    "drizzle-kit": "^0.31.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "eslint-plugin-storybook": "^0.6.15",
    "husky": "^9.0.10",
    "jest": "^29.7.0",
    "only-allow": "^1.2.1",
    "postcss": "^8.4.35",
    "prettier": "3.2.5",
    "storybook": "^7.6.15",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3"
  }
}

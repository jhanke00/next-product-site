{
  "name": "next-product-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "format": "prettier . --write",
    "preinstall": "only-allow pnpm",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "generate-large-data": "node ./scripts/generateLargeData.js",
    "generate-small-data": "node ./scripts/generateSmallData.js",
    "lint:fix": "eslint . --fix",
    "lint": "eslint 'src/**/*.{ts,tsx,js,jsx}'",
    "test": "jest --coverage",
    "precommit-checks": "npm run lint || echo 'Lint errors found!' && npm run test -- --coverageThreshold='{\"global\":{\"branches\":50,\"functions\":50,\"lines\":50,\"statements\":50}}' || echo 'Tests or coverage failed!'"

  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-devtools": "^5.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "next": "15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@faker-js/faker": "^8.4.1",
    "@storybook/addon-jest": "~9.1.8",
    "@storybook/nextjs": "^9.1.8",
    "@tailwindcss/postcss": "~4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^9.1.8",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.2.0",
    "only-allow": "^1.2.1",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "storybook": "^9.1.8",
    "tailwindcss": "^4.1.13",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.2"
  }
}

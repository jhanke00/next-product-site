# Add your environment variables below
# NextJS environment variable setup: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

NEXT_PUBLIC_APP_URL=http://localhost:3000

NODE_ENV=development

#web
PORT="3000"

# postgres
POSTGRES_USER="posgres_user"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_HOST="postgres"
POSTGRES_DB="product"
POSTGRES_PORT="5432"

#aws
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
AWS_DEFAULT_REGION="us-east-1"
AWS_SQS_REVIEWS_QUEUE_URL="http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/reviews-queue.fifo"
AWS_SQS_REVIEWS_MAX_NUMBER_OF_MESSAGES: "1"
AWS_SQS_REVIEWS_WAIT_TIME_SECONDS: "20"
AWS_SQS_REVIEWS_VISIBILITY_TIMEOUT: "180" # 180 seconds/3 minutes,

#redis
REDIS_PASSWORD="my_redis_password"
REDIS_USER="my_user"
REDIS_USER_PASSWORD="my_user_password"
REDIS_HOST="redis"
REDIS_PORT="6379"

#localstack
LOCALSTACK_HOST_PORT="4566"

# Add your environment variables below
# NextJS environment variable setup: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# NEXT_PUBLIC_VAR="sample-value"
# PRIVATE_VAR="sample-value"

# Twilio SMS configuration (fill with your real credentials)
# Get Account SID and Auth Token from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Either use a Twilio phone number OR a Messaging Service SID
# Twilio phone number in E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=""

# Optional: Twilio Messaging Service SID (preferred for production)
# TWILIO_MESSAGING_SERVICE_SID=""